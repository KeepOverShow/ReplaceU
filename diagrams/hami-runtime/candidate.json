      "label": "HAMi-core",
      "sublabel": "容器内预算检查"
    },
    {
      "id": "driver",
      "type": "backend",
      "label": "CUDA Driver",
      "sublabel": "执行获准的申请"
    }
  ],
  "messages": [
    {
      "id": "first",
      "from": "app",
      "to": "core",
      "y": 160,
      "label": "申请 2 GiB",
      "variant": "emphasis",
      "note": "教学预算 4 GiB，当前使用 0 GiB"
    },
    {
      "id": "allow",
      "from": "core",
      "to": "driver",
      "y": 230,
      "label": "预算内，转交调用",
      "variant": "security"
    },
    {
      "id": "allocated",
      "from": "driver",
      "to": "core",
      "y": 275,
      "label": "底层申请成功",
      "variant": "return"
    },
    {
      "id": "ok",
      "from": "core",
      "to": "app",
      "y": 320,
      "label": "返回成功",
      "variant": "return",
      "note": "示例假定底层成功，已用预算成为 2 GiB"
    },
    {
      "id": "over",
      "from": "app",
      "to": "core",
      "y": 390,
      "label": "再申请 3 GiB",
      "variant": "emphasis"
    },
    {
      "id": "reject",
      "from": "core",
      "to": "app",
      "y": 435,
      "label": "超过剩余预算，拒绝",
      "variant": "security",
      "note": "这条超限路径不转交 Driver"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "这是运行时示意",
      "items": [
