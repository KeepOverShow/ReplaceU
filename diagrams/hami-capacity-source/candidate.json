  "cards": [
    {
      "dot": "cyan",
      "title": "沿数据追，分清调用",
      "items": [
        "接收方法调用回调；回调重建 healthyDevices / unhealthyDevices。",
        "GetCapacity 在另一条节点状态更新路径读取集合；回调没有直接调用它。",
        "容器管理器包装返回结果；MachineInfo 的 Setter 写本地 Node 对象，后续再发布。"
      ]
    },
    {
      "dot": "rose",
      "title": "三个必须解释的分支",
      "items": [
        "健康数赋给 capacity 和 allocatable；不健康数只加到 capacity。",
        "端点失效会触发清理，失效资源名交给 Setter 将容量设为 0。",
        "GetCapacity 解锁后才调用再次加锁的 writeCheckpoint，返回值和落盘不是一个原子事务。"
      ]
    },
    {
      "dot": "emerald",
      "title": "数量与设备 ID 是两条读路径",
      "items": [
        "GetCapacity 统计健康/不健康设备，构造 Node 的 capacity 与 allocatable 数量。",
        "devicesToAllocate 从 healthyDevices 中减去 allocatedDevices，再处理可重用设备、NUMA 与插件偏好，选择具体 ID。",
        "因此“Node 数量仍为 2”不意味着同一个 ID 可交给两个容器；要继续审计本地分配状态和 Allocate 交接。"
      ]
    }
  ]
